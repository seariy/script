### Target Board: K2P-USB
### Target Architecture: MediaTek MT7621AT (MIPS 1004Kc)
### Linux Kernel: 4.4.x (TurBoTse/padavan)

CONFIG_FIRMWARE_PRODUCT_ID="K2P-USB"

### CPU Architecture Flags
CONFIG_FIRMWARE_CPU_MIPS=y
CONFIG_FIRMWARE_CPU_MT7621=y

### Storage & Flash Partition (16MB / 32MB SPI Flash)
CONFIG_FIRMWARE_ROOTFS_SQUASHFS=y
CONFIG_FIRMWARE_INCLUDE_MTD_RW=y

### Linux Network & Bridging
CONFIG_FIRMWARE_INCLUDE_IPV6=y
CONFIG_FIRMWARE_INCLUDE_IPSET=y
CONFIG_FIRMWARE_INCLUDE_IPTABLES=y
CONFIG_FIRMWARE_INCLUDE_DNSMASQ=y
CONFIG_FIRMWARE_INCLUDE_HTTPD=y

### AP Mode & DHCP Enhancement
CONFIG_FIRMWARE_INCLUDE_UDHCPC=y
CONFIG_FIRMWARE_INCLUDE_ETH_MONITOR=y

### USB Support (K2P-USB Hardware Mod)
CONFIG_FIRMWARE_ENABLE_USB=y
CONFIG_FIRMWARE_ENABLE_EXT2=y
CONFIG_FIRMWARE_ENABLE_EXT3=y
CONFIG_FIRMWARE_ENABLE_EXT4=y
CONFIG_FIRMWARE_ENABLE_FAT=y
CONFIG_FIRMWARE_ENABLE_EXFAT=y
CONFIG_FIRMWARE_ENABLE_NTFS=y

### WireGuard Support
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y
CONFIG_FIRMWARE_INCLUDE_WIREGUARD_TOOLS=y

### SSL & Networking Tools
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EC=y
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EXE=y
CONFIG_FIRMWARE_INCLUDE_CURL=y
CONFIG_FIRMWARE_INCLUDE_WGET=y
CONFIG_FIRMWARE_INCLUDE_CA_CERTIFICATES=y

### SmartDNS (Optional)
# CONFIG_FIRMWARE_INCLUDE_SMARTDNS is not set

### General Utilities
CONFIG_FIRMWARE_INCLUDE_SHADOWSOCKS=n
CONFIG_FIRMWARE_INCLUDE_SSOBFS=n
CONFIG_FIRMWARE_INCLUDE_XRAY=n
CONFIG_FIRMWARE_INCLUDE_V2RAY=n
CONFIG_FIRMWARE_INCLUDE_TROJAN=n
CONFIG_FIRMWARE_INCLUDE_ZEROTIER=n
